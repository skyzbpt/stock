{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stock",
	"main": "worker.js",
	"compatibility_date": "2026-07-02",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 網頁用到的圖示與 PWA 檔案一起打包進 Worker，打開 Worker 網址時 favicon、安裝 App 才會正常。
	// fallthrough: true 讓內建規則（例如 index.html 當文字打包）繼續生效，不能拿掉。
	"rules": [
		{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true },
		{ "type": "Text", "globs": ["**/*.svg", "**/*.webmanifest", "**/sw.js"], "fallthrough": true }
	],
	// 雲端同步用的 Cloudflare D1 資料庫。沒有填 database_id：部署時 wrangler 會找名為 stock-db 的資料庫，
	// 找不到就自動建立；之後的部署沿用同一個。資料表由 worker.js 第一次用到時自動建立。
	"d1_databases": [
		{ "binding": "DB", "database_name": "stock-db" }
	],
	// 盤中走勢紀錄：週一至週五台灣時間 09:00–13:59（UTC 01:00–05:59）每分鐘跑一次，程式內再限制到 13:35
	"triggers": { "crons": ["* 1-5 * * 1-5"] }
}
